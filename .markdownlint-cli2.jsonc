{
  "globs": ["**/*.md", ".github/**/*.md"],
  "config": {
    "MD013": {
      "line_length": 120,
      "tables": false,
      "code_blocks": false,
    },
    "MD024": {
      "siblings_only": true,
    },
  },
  "ignores": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/.package-test/**",
    ".ha-dev/**",
    "**/dist/**",
    "**/build/**",
    "**/*.egg-info/**",
  ],
}

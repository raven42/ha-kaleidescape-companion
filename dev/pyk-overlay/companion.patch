+def _encode_field(value: str) -> str:
+    """Encode a printable-protocol field without changing its boundaries."""
+    if not isinstance(value, str):
+        raise TypeError("Protocol fields must be strings")
+    escaped = {
+        "\\": r"\\",
+        "/": r"\/",
+        ":": r"\:",
+        "\n": r"\n",
+        "\r": r"\r",
+        "\t": r"\t",

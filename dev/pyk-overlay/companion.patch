index 0000000..4a69e06
--- /dev/null
+++ b/kaleidescape/library_parser.py
@@ -0,0 +1,294 @@
+"""Bounded, read-only parsing of the local browser interface; never execute JS."""
+
+# pylint: disable=missing-function-docstring,redefined-builtin,too-many-locals,too-many-statements
+
+import re
+from dataclasses import dataclass, field
+from html.parser import HTMLParser
+from urllib.parse import parse_qs, urlsplit
+
+from .error import KaleidescapeError
+
+
+class LibraryFormatError(KaleidescapeError):
+    """A local browser page was incomplete or had an unsupported layout."""
+
+
+MAX_TITLES = 10_000
+MAX_COLLECTIONS = 200
+VOID = frozenset(
+    {
+        "area",
+        "base",
+        "br",
+        "col",
+        "embed",
+        "hr",
+        "img",
+        "input",
+        "link",
+        "meta",
+        "param",
+        "source",
+        "track",
+        "wbr",
+    }
+)
+
+
+def malformed() -> LibraryFormatError:
+    """Do not disclose source pages, addresses, or metadata in errors."""
+    return LibraryFormatError("The library page format was not recognized")
+
+
+def clean(value: str, limit: int = 500) -> str:
+    """Bound untrusted text while retaining Unicode metadata."""
+    value = " ".join(value.split())
+    if len(value) > limit or "\x00" in value:
+        raise malformed()
+    return value
+
+
+def identity(value: str) -> str:
+    """Reject malformed identifiers instead of normalizing their raw identity."""
+    if not value or len(value) > 256 or any(c.isspace() or ord(c) < 32 for c in value):
+        raise malformed()
+    return value
+
+
+@dataclass
+class Node:
+    """Small structural tree backed by Python's HTML parser."""
+
+    tag: str = ""
+    attrs: dict[str, str] = field(default_factory=dict)
+    children: list = field(default_factory=list)
+
+    def nodes(self):
+        for child in self.children:
+            if isinstance(child, Node):
+                yield child
+                yield from child.nodes()
+
+    def find(self, *, id=None, cls=None, tag=None):
+        return next(
+            (
+                node
+                for node in self.nodes()
+                if (id is None or node.attrs.get("id") == id)
+                and (cls is None or cls in node.attrs.get("class", "").split())
+                and (tag is None or node.tag == tag)
+            ),
+            None,
+        )
+
+    def text(self) -> str:
+        if self.tag in {"script", "style"}:
+            return ""
+        return " ".join(
+            child.text() if isinstance(child, Node) else child
+            for child in self.children
+        )
+
+
+class Tree(HTMLParser):
+    """Keep depth/node limits even for malformed or hostile HTML."""
+
+    def __init__(self, source: str):
+        super().__init__(convert_charrefs=True)
+        self.root = Node()
+        self.stack = [self.root]
+        self.count = 0
+        if len(source) > 8 * 1024 * 1024:
+            raise malformed()
+        self.feed(source)
+        self.close()
+
+    def handle_starttag(self, tag, attrs):
+        self.count += 1
+        if self.count > 200_000 or len(self.stack) > 64:
+            raise malformed()
+        node = Node(tag, {key: value or "" for key, value in attrs})
+        self.stack[-1].children.append(node)
+        if tag not in VOID:
+            self.stack.append(node)
+
+    def handle_startendtag(self, tag, attrs):
+        self.handle_starttag(tag, attrs)
+        if tag not in VOID:
+            self.handle_endtag(tag)
+
+    def handle_endtag(self, tag):
+        for index in range(len(self.stack) - 1, 0, -1):
+            if self.stack[index].tag == tag:
+                self.stack = self.stack[:index]
+                break
+
+    def handle_data(self, data):
+        self.stack[-1].children.append(data)
+
+
+def catalog(source: str) -> tuple[list[dict], list[str] | None]:
+    """Validate the entire listing before any missing titles become unavailable."""
+    root = Tree(source).root
+    count_node = root.find(id="movie_count_str")
+    if count_node is None or root.find(tag="table") is None:
+        raise malformed()
+    count_text = clean(count_node.text()).replace(",", "")
+    match = re.fullmatch(r"(\d+|No)(?:\s+movies?)?", count_text, re.IGNORECASE)
+    if not match:
+        raise malformed()
+    expected = 0 if match[1].lower() == "no" else int(match[1])
+    rows: dict[str, dict] = {}
+    groups: set[str] = set()
+    for node in root.nodes():
+        if (
+            node.tag != "tr"
+            or "movie_container" not in node.attrs.get("class", "").split()
+        ):
+            continue
+        handle = identity(node.attrs.get("selection_handle", ""))
+        group = identity(node.attrs.get("selection_group", ""))
+        title = node.find(cls="movie_title")
+        if not handle or not group or title is None or not clean(title.text()):
+            raise malformed()
+        groups.add(group)
+
+        def cell(cls, node=node):
+            value = node.find(cls=cls)
+            return clean(value.text()) if value else ""
+
+        edition = cell("movie_media_type")
+        known = [edition] if edition and edition.casefold() != "multiple" else []
+        if handle in rows:
+            if rows[handle]["source_group"] != group:
+                raise malformed()
+            formats = sorted(
+                set(rows[handle]["formats"]) | set(known), key=str.casefold
+            )
+            if len(formats) > 100:
+                raise malformed()
+            rows[handle]["formats"] = formats
+            if formats:
+                rows[handle]["edition"] = formats[0]
+            continue  # A summary row and its concrete format may share a handle.
+        year = cell("movie_year")
+        rows[handle] = {
+            "source_handle": handle,
+            "source_group": group,
+            "title": clean(title.text()),
+            "rating": cell("movie_rating"),
+            "directors": names(cell("movie_director")),
+            "genres": names(cell("movie_genre")),
+            "year": int(year)
+            if year.isascii() and year.isdigit() and len(year) == 4
+            else None,
+            "edition": edition,
+            "formats": known,
+        }
+        if len(rows) > MAX_TITLES:
+            raise malformed()
+    if len(groups) != expected or expected > MAX_TITLES:
+        raise malformed()
+    collections = set()
+    pulldown = root.find(id="collection_pulldown")
+    if pulldown is None:
+        return list(rows.values()), None
+    for node in pulldown.nodes():
+        if node.tag != "a":
+            continue
+        url = urlsplit(node.attrs.get("href", ""))
+        if url.scheme or url.netloc or url.path not in {"/movies", "movies"}:
+            continue
+        values = parse_qs(url.query).get("collection", [])
+        if len(values) == 1 and (name := clean(values[0], 256)):
+            # The built-in Scenes menu opens scene management, not a title
+            # collection. Parsing it as Movies aborts every collection refresh.
+            if name.casefold() == "scenes":
+                continue
+            collections.add(name)
+    if len(collections) > MAX_COLLECTIONS:
+        raise malformed()
+    if not {"played", "paused"}.issubset(name.casefold() for name in collections):
+        return list(rows.values()), None
+    return list(rows.values()), sorted(collections)
+
+
+def names(value: str) -> list[str]:
+    """Retain only provided names, never fabricate absent credits."""
+    values = list(
+        dict.fromkeys(
+            clean(part) for part in re.split(r"[,;\n]", value) if part.strip()
+        )
+    )
+    if len(values) > 100:
+        raise malformed()
+    return values
+
+
+def artwork_path(value: str) -> str | None:
+    """Only the observed read-only cover directories, without URLs or queries."""
+    if len(value) > 1024:
+        return None
+    if not re.fullmatch(
+        r"/webcovers(?:large)?/[A-Za-z0-9_./-]+\.(?:jpg|jpeg|png|webp)",
+        value,
+        re.IGNORECASE,
+    ):
+        return None
+    if any(part in {"", ".", ".."} for part in value.split("/")[1:]):
+        return None
+    return value
+
+
+def details(source: str) -> dict:
+    """Read known labeled fields and covers; ignore forms/editing routes/scripts."""
+    root = Tree(source).root
+    title = root.find(id="movie_title")
+    if title is None or not clean(title.text()):
+        raise malformed()
+    result: dict[str, object] = {
+        "actors": [],
+        "writers": [],
+        "studios": [],
+        "synopsis": "",
+        "duration_seconds": None,
+        "artwork_path": None,
+    }
+    labels = {
+        "cast": "actors",
+        "actors": "actors",
+        "director": "directors",
+        "directors": "directors",
+        "writer": "writers",
+        "writers": "writers",
+        "written by": "writers",
+        "studio": "studios",
+        "studios": "studios",
+        "genres": "genres",
+    }
+    for row in root.nodes():
+        if row.tag != "tr":
+            continue
+        label, value = row.find(cls="details_name"), row.find(cls="details_value")
+        if label is None or value is None:
+            continue
+        name = clean(label.text()).rstrip(":").casefold()
+        if name in labels:
+            result[labels[name]] = names(clean(value.text(), 20_000))
+        elif name == "synopsis":
+            result["synopsis"] = clean(value.text(), 20_000)
+    misc = root.find(id="misc_text")
+    if misc and (
+        match := re.search(
+            r"\b(\d+(?:\.\d+)?)\s*min(?:ute)?s?\b", misc.text(), re.IGNORECASE
+        )
+    ):
+        minutes = float(match[1])
+        if 0 <= minutes <= 1440:
+            result["duration_seconds"] = minutes * 60
+    cover = root.find(id="cover_art")
+    image = cover.find(tag="img") if cover else None
+    if image:
+        result["artwork_path"] = artwork_path(image.attrs.get("src", ""))
+    return result
diff --git a/kaleidescape/local_browser.py b/kaleidescape/local_browser.py
new file mode 100644
index 0000000..eb3cb91
--- /dev/null
+++ b/kaleidescape/local_browser.py
@@ -0,0 +1,419 @@
+"""Local server browser access through built-in or injected transport.
+
+The built-in transport connects directly to a literal private IP and bounds each
+request. Caller-owned transports may be injected for specialized network policy.
+Constructing either browser object performs no I/O.
+"""
+
+# pylint: disable=missing-function-docstring,too-many-boolean-expressions
+
+from __future__ import annotations
+
+import asyncio
+import http.client
+import ipaddress
+import math
+import re
+import secrets
+from dataclasses import dataclass
+from typing import Protocol
+from urllib.parse import urlencode
+
+from .error import KaleidescapeError
+from .library_parser import (
+    LibraryFormatError,
+    Tree,
+    artwork_path,
+    catalog,
+    clean,
+    details,
+    identity,
+)
+
+MAX_PAGE = 8 * 1024 * 1024
+MAX_ARTWORK = 8 * 1024 * 1024
+IMAGE_TYPES = {"image/jpeg", "image/png", "image/webp"}
+TEXT_TYPES = {"text/html", "application/xhtml+xml"}
+CHARSETS = {"utf-8", "utf8", "iso-8859-1", "latin-1", "windows-1252"}
+RESERVED_COLLECTIONS = {"all", "new", "played", "paused", "scenes", "trash", "deleted"}
+
+
+class BrowserResponseError(KaleidescapeError):
+    """A browser response was too large, malformed, or outside the allowed routes."""
+
+
+class BrowserOutcomeUnknownError(KaleidescapeError):
+    """A collection POST may have reached the browser, but its result is unknown."""
+
+
+@dataclass(frozen=True)
+class BrowserResponse:
+    """A bounded response provided by an owned HTTP transport."""
+
+    status: int
+    content_type: str
+    body: bytes
+    charset: str | None = None
+    content_encoding: str = "identity"
+    location: str | None = None
+
+
+class BrowserTransport(Protocol):
+    """Enforce the network policy above and encode POST fields as multipart/form-data.
+
+    Never retry a POST, and return only after the full bounded response is read.
+    """
+
+    async def get(self, path: str) -> BrowserResponse: ...
+
+    async def post(self, path: str, fields: dict[str, str]) -> BrowserResponse: ...
+
+
+@dataclass(frozen=True)
+class CollectionPostResult:
+    """HTTP acknowledgement only; membership must be checked separately."""
+
+    status: int
+    location: str | None
+
+
+def _text(response: BrowserResponse) -> str:
+    if (
+        response.status != 200
+        or response.content_type.lower() not in TEXT_TYPES
+        or response.content_encoding.lower() != "identity"
+        or len(response.body) > MAX_PAGE
+    ):
+        raise BrowserResponseError("Unsupported browser page response")
+    charset = (response.charset or "iso-8859-1").lower()
+    if charset not in CHARSETS:
+        raise BrowserResponseError("Unsupported browser page charset")
+    try:
+        return response.body.decode(charset)
+    except UnicodeError as error:
+        raise BrowserResponseError("Invalid browser page encoding") from error
+
+
+def _image_type(body: bytes) -> str | None:
+    if body.startswith(b"\xff\xd8\xff"):
+        return "image/jpeg"
+    if body.startswith(b"\x89PNG\r\n\x1a\n"):
+        return "image/png"
+    if body.startswith(b"RIFF") and body[8:12] == b"WEBP":
+        return "image/webp"
+    return None
+
+
+def _collection_name(value: str) -> str:
+    if (
+        not isinstance(value, str)
+        or not value
+        or len(value) > 256
+        or value != " ".join(value.split())
+        or value.casefold() in RESERVED_COLLECTIONS
+        or any(ord(c) < 32 for c in value)
+    ):
+        raise ValueError("Invalid collection name")
+    return value
+
+
+def form_targets(page: str, handle: str) -> dict[str, str]:
+    """Parse the live add-only form and selected version's checkbox."""
+    identity(handle)
+    root = Tree(page).root
+    form = root.find(id="main", tag="form")
+    if (
+        form is None
+        or form.attrs.get("method", "").lower() != "post"
+        or form.attrs.get("enctype", "").lower() != "multipart/form-data"
+        or form.attrs.get("action", "") not in {"", "/movies", "movies"}
+    ):
+        raise LibraryFormatError("Collection add form was not recognized")
+    button = form.find(id="add_to_collection", tag="button")
+    field = form.find(id="add_to_collection_select_dropdown_value", tag="input")
+    dropdown = form.find(id="add_to_collection_select_dropdown")
+    if (
+        button is None
+        or button.attrs.get("onclick", "").strip()
+        != "submit_parent_form_once( event, 'Add-To-Collection' );"
+        or field is None
+        or field.attrs.get("name") != "add_to_collection_select"
+        or dropdown is None
+    ):
+        raise LibraryFormatError("Collection add form was not recognized")
+    controls = [
+        node
+        for node in form.nodes()
+        if node.tag == "input"
+        and node.attrs.get("name") == "check-" + handle
+        and node.attrs.get("type", "").lower() == "checkbox"
+        and "disabled" not in node.attrs
+    ]
+    if not controls or any(node.attrs.get("value", "on") != "on" for node in controls):
+        raise LibraryFormatError("Selected version cannot be added")
+    targets: dict[str, str] = {}
+    for node in dropdown.nodes():
+        if (
+            node.tag != "li"
+            or "dropdown_option" not in node.attrs.get("class", "").split()
+        ):
+            continue
+        label = clean(node.text(), 256)
+        if not label or label.casefold() in RESERVED_COLLECTIONS:
+            continue
+        value = node.find(tag="input")
+        if value is None or "disabled" in value.attrs:
+            continue
+        raw = value.attrs.get("value", "")
+        if not raw:
+            continue
+        if label in targets or len(raw) > 512 or any(ord(char) < 32 for char in raw):
+            raise LibraryFormatError("Invalid collection choice")
+        targets[label] = raw
+    if len(targets) > 200:
+        raise LibraryFormatError("Too many collection choices")
+    return targets
+
+
+class LocalLibrary:
+    """Read and add to the local movie browser through one injected transport."""
+
+    def __init__(self, transport: BrowserTransport):
+        self._transport = transport
+
+    async def movies(self) -> tuple[list[dict], list[str] | None]:
+        """Return a complete catalog and available collection names."""
+        return catalog(_text(await self._transport.get("/movies")))
+
+    async def collection(self, name: str) -> list[dict]:
+        """Return one complete collection listing."""
+        name = clean(name, 256)
+        if not name:
+            raise ValueError("Empty collection")
+        path = "/movies?" + urlencode({"collection": name, "sort": 2})
+        rows, _ = catalog(_text(await self._transport.get(path)))
+        return rows
+
+    async def version_details(self, handle: str) -> dict:
+        """Return metadata for one exact version handle."""
+        identity(handle)
+        path = "/details?" + urlencode({"id": handle, "callback": "true"})
+        return details(_text(await self._transport.get(path)))
+
+    async def artwork(self, path: str) -> tuple[bytes, str]:
+        """Return validated image bytes from an allowed local cover route."""
+        if artwork_path(path) != path:
+            raise ValueError("Invalid artwork path")
+        response = await self._transport.get(path)
+        if (
+            response.status != 200
+            or response.content_type.lower() not in IMAGE_TYPES
+            or response.content_encoding.lower() != "identity"
+            or len(response.body) > MAX_ARTWORK
+            or _image_type(response.body) != response.content_type.lower()
+        ):
+            raise BrowserResponseError("Invalid artwork response")
+        return response.body, response.content_type.lower()
+
+    async def add_targets(self, handle: str) -> dict[str, str]:
+        """Read the current add form; values are opaque internal choice IDs."""
+        return form_targets(_text(await self._transport.get("/movies")), handle)
+
+    async def add_to_collection(
+        self, handle: str, collection: str
+    ) -> CollectionPostResult:
+        """Submit one offered add-only form; never retry or infer membership."""
+        identity(handle)
+        collection = _collection_name(collection)
+        page = _text(await self._transport.get("/movies"))
+        rows, _ = catalog(page)
+        if not any(row["source_handle"] == handle for row in rows):
+            raise LibraryFormatError("Selected version is absent from listing")
+        choices = form_targets(page, handle)
+        if collection not in choices:
+            raise LibraryFormatError("Collection is not an offered add target")
+        fields = {
+            "submit_type": "Add-To-Collection",
+            "add_to_collection_select": choices[collection],
+            "check-" + handle: "on",
+        }
+        try:
+            response = await self._transport.post("/movies", fields)
+        except (KeyboardInterrupt, SystemExit):
+            raise
+        except BaseException as error:
+            raise BrowserOutcomeUnknownError(
+                "Collection POST outcome is unknown"
+            ) from error
+        if (
+            response.status not in {200, 302, 303}
+            or response.content_encoding.lower() != "identity"
+            or len(response.body) > MAX_PAGE
+            or (
+                response.status != 200
+                and response.location not in {"/movies", "movies"}
+            )
+        ):
+            raise BrowserOutcomeUnknownError("Collection POST outcome is unknown")
+        return CollectionPostResult(response.status, response.location)
+

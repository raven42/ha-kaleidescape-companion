+        if char in escaped:
+            parts.append(escaped[char])
+        elif 32 <= ord(char) <= 126:
+            parts.append(char)
+        elif 127 <= ord(char) <= 255:
+            parts.append(f"\\d{ord(char):03}")
+        else:
+            raise ValueError("Protocol field contains an unsupported character")
+    return "".join(parts)

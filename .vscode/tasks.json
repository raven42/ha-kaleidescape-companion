{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Build",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "hide": true,
      "presentation": {
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "Post-build checks",
      "dependsOn": [
        "Post-build: Python tests",
        "Post-build: Frontend tests",
        "Package"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "Post-build: Python tests",
      "type": "process",
      "command": "${workspaceFolder}/scripts/test",
      "args": ["--python-only"],
      "problemMatcher": [],
      "hide": true,
      "presentation": {
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "Post-build: Frontend tests",
      "type": "process",
      "command": "${workspaceFolder}/scripts/test",
      "args": ["--frontend-only"],
      "problemMatcher": [],
      "hide": true,
      "presentation": {
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "Package",
      "type": "process",
      "command": "${workspaceFolder}/scripts/package",
      "problemMatcher": [],
      "group": "build",
      "hide": true,
      "presentation": {
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "Maintainer: Deploy frontend",
      "type": "process",
      "command": "${workspaceFolder}/scripts/deploy",
      "args": ["frontend"],
      "dependsOn": ["Build"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Maintainer: Deploy prepared artifact",
      "type": "process",
      "command": "${workspaceFolder}/scripts/deploy",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "hide": true
    },
    {
      "label": "Maintainer: Check configuration and restart",
      "type": "process",
      "command": "${workspaceFolder}/scripts/restart",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "hide": true
    },
    {
      "label": "Maintainer: Build, check, package, deploy and restart",
      "dependsOn": [
        "Build",
        "Post-build checks",
        "Maintainer: Deploy prepared artifact",
        "Maintainer: Check configuration and restart"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}

{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Setup dependencies",
      "type": "process",
      "command": "bash",
      "args": [
        "dev/dev.sh",
        "setup"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build frontend",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "frontend",
        "run",
        "build"
      ],
      "problemMatcher": [
        "$tsc"
      ],
      "group": "build"
    },
    {
      "label": "Build integration package",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "dev/deploy.py",
        "package"
      ],
      "dependsOn": [
        "Check all"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Initialize deployment settings",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "dev/deploy.py",
        "init"
      ],
      "problemMatcher": []
    },
    {
      "label": "Preview test HA deployment",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "dev/deploy.py",
        "plan"
      ],
      "dependsOn": [
        "Build integration package"
      ],
      "problemMatcher": []
    },
    {
      "label": "Deploy to test HA",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "dev/deploy.py",
        "deploy"
      ],
      "dependsOn": [
        "Build integration package"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Check configuration and restart test HA",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "dev/deploy.py",
        "restart"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Build, deploy and restart test HA",
      "dependsOn": [
        "Deploy to test HA",
        "Check configuration and restart test HA"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Test Python",
      "type": "process",
      "command": "bash",
      "args": [
        "dev/dev.sh",
        "python-test"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check project",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "dev/check_project.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Lint Python",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ruff",
        "check",
        "."
      ],
      "problemMatcher": []
    },
    {
      "label": "Check Python formatting",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "problemMatcher": []
    },
    {
      "label": "Test frontend",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "frontend",
        "test"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Audit dependencies (network)",
      "type": "process",
      "command": "bash",
      "args": [
        "dev/dev.sh",
        "audit"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check frontend formatting",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "frontend",
        "run",
        "format:check"
      ],
      "problemMatcher": []
    },
    {
      "label": "Lint frontend",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "frontend",
        "run",
        "lint"
      ],
      "problemMatcher": []
    },
    {
      "label": "Lint Markdown",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "frontend",
        "run",
        "lint:markdown"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check documentation formatting",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "frontend",
        "run",
        "format:docs:check"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check all",
      "type": "process",
      "command": "bash",
      "args": [
        "dev/dev.sh",
        "check"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run frontend preview",
      "type": "process",
      "command": "bash",
      "args": [
        "dev/dev.sh",
        "preview"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Run Home Assistant",
      "type": "process",
      "command": "bash",
      "args": [
        "dev/dev.sh",
        "ha"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Open frontend webview",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        ":",
        "${input:openFrontendWebview}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Open Home Assistant webview",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        ":",
        "${input:openHomeAssistantWebview}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Open server webviews",
      "dependsOn": [
        "Open frontend webview",
        "Open Home Assistant webview"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openFrontendWebview",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://127.0.0.1:5173/"
    },
    {
      "id": "openHomeAssistantWebview",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://127.0.0.1:8123/"
    }
  ]
}

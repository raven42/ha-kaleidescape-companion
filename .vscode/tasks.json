{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Setup dependencies",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/dev.sh",
        "setup"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build frontend",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "frontend",
        "run",
        "build"
      ],
      "problemMatcher": [
        "$tsc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test Python",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check scaffold",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/check_scaffold.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Lint Python",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ruff",
        "check",
        "."
      ],
      "problemMatcher": []
    },
    {
      "label": "Check Python formatting",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "problemMatcher": []
    },
    {
      "label": "Test frontend",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "frontend", "test"],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Audit dependencies (network)",
      "type": "process",
      "command": "bash",
      "args": ["scripts/dev.sh", "audit"],
      "problemMatcher": []
    },
    {
      "label": "Check frontend formatting",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "frontend", "run", "format:check"],
      "problemMatcher": []
    },
    {
      "label": "Check all",
      "dependsOn": [
        "Build frontend",
        "Test Python",
        "Test frontend",
        "Check frontend formatting",
        "Check scaffold",
        "Lint Python",
        "Check Python formatting"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run frontend preview",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/dev.sh",
        "preview"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Run Home Assistant",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/dev.sh",
        "ha"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Open frontend webview",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        ":",
        "${input:openFrontendWebview}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Open Home Assistant webview",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        ":",
        "${input:openHomeAssistantWebview}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Open server webviews",
      "dependsOn": [
        "Open frontend webview",
        "Open Home Assistant webview"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openFrontendWebview",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://127.0.0.1:5173/"
    },
    {
      "id": "openHomeAssistantWebview",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://127.0.0.1:8123/"
    }
  ]
}

{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Setup",
      "type": "process",
      "command": "${workspaceFolder}/scripts/setup",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Lint",
      "type": "process",
      "command": "${workspaceFolder}/scripts/lint",
      "problemMatcher": []
    },
    {
      "label": "Format",
      "type": "process",
      "command": "${workspaceFolder}/scripts/format",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "process",
      "command": "${workspaceFolder}/scripts/test",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check",
      "type": "process",
      "command": "${workspaceFolder}/scripts/check",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Package",
      "type": "process",
      "command": "${workspaceFolder}/scripts/package",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Frontend preview",
      "type": "process",
      "command": "${workspaceFolder}/scripts/preview",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Local Home Assistant",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ha",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Dependency audit (network)",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dependency-audit",
      "problemMatcher": []
    },
    {
      "label": "Maintainer: Preview deployment",
      "type": "process",
      "command": "${workspaceFolder}/scripts/deploy",
      "problemMatcher": [],
      "args": ["plan"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Maintainer: Deploy prepared artifact",
      "type": "process",
      "command": "${workspaceFolder}/scripts/deploy",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Maintainer: Check configuration and restart",
      "type": "process",
      "command": "${workspaceFolder}/scripts/restart",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Maintainer: Build, check, package, deploy and restart",
      "dependsOn": [
        "Build",
        "Check",
        "Package",
        "Maintainer: Deploy prepared artifact",
        "Maintainer: Check configuration and restart"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}

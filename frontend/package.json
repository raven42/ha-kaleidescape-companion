{
  "name": "kaleidescape-companion",
  "version": "0.6.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --config vite.preview.config.mjs --host 127.0.0.1",
    "test": "node --test tests/security.test.mjs && vitest run",
    "format": "prettier --write src dev tests *.mjs *.mts",
    "format:check": "prettier --check src dev tests *.mjs *.mts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node dev/package.mjs",
    "build:check": "npm run typecheck && node dev/check-build.mjs",
    "lint": "eslint src dev tests *.mjs *.mts",
    "lint:markdown": "cd .. && frontend/node_modules/.bin/markdownlint-cli2",
    "format:docs": "cd .. && frontend/node_modules/.bin/prettier --write --prose-wrap always --ignore-path .gitignore \"**/*.md\" \".github/**/*.md\"",
    "format:docs:check": "cd .. && frontend/node_modules/.bin/prettier --check --prose-wrap always --ignore-path .gitignore \"**/*.md\" \".github/**/*.md\""
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "home-assistant-js-websocket": "^9.8.1",
    "markdownlint-cli2": "0.24.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "katex": "^0.18.2",
      "re2js": "^2.8.7"
    },
    "minimatch@10": "11.0.4"
  }
}

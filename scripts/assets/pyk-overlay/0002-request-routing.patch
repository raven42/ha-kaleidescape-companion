+def _encode_field(value: str) -> str:
+    """Escape delimiters and control characters in a request field."""
+    escapes = {
+        "\\": r"\\",
+        "/": r"\/",
+        ":": r"\:",
+        "\n": r"\n",
+        "\r": r"\r",
+        "\t": r"\t",
+    }
+    return "".join(
+        escapes.get(
+            char,
+            f"\\d{ord(char):03}" if ord(char) < 32 or 127 <= ord(char) <= 255 else char,
+        )
+        for char in value
+    )
+
+
